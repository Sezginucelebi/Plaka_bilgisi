<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ✅ Material3 özelleştirilmiş tema -->
    <style name="Theme.Material3.DayNight.NoActionBar" parent="Theme.Material3.DayNight">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 🌙 Normal uygulama teması -->
    <style name="Theme.Plaka_Bilgisi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#3582F4</item>
        <item name="colorSecondary">#66A7FF</item>
        <item name="android:statusBarColor">#0C1018</item>
        <item name="android:navigationBarColor">#0C1018</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ⚡ Android 12+ sistem splash screen teması -->
    <style name="Theme.Plaka_Bilgisi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground" type="color">#0C1018</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Plaka_Bilgisi</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
    </style>

</resources>
